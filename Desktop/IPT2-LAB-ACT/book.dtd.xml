<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE book [
  <!ELEMENT book (title, author, year, publisher)>
  <!ATTLIST book id ID #REQUIRED
                  genre CDATA #REQUIRED>
  
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT year (#PCDATA)>
  <!ELEMENT publisher (name, country, founded)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT country (#PCDATA)>
  <!ELEMENT founded (#PCDATA)>
]>
<book id="b01" genre="fiction">
  <title>The Great Gatsby</title>
  <author>F. Scott Fitzgerald</author>
  <year>1925</year>
  <publisher>
    <name>Scribner</name>
    <country>USA</country>
    <founded>1846</founded>
  </publisher>
</book>